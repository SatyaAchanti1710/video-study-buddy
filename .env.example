# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your key.
# Never share the .env file: it holds your paid API key.
# ---------------------------------------------------------------------------

# "openai" works with OpenAI and any OpenAI-compatible API (OpenRouter, Groq,
# DeepSeek, local Ollama, ...). Use "anthropic" for Claude.
LLM_PROVIDER=openai

# Paste your API key after the equals sign. No quotes, no spaces.
LLM_API_KEY=sk-paste-your-key-here

# The model name exactly as your provider writes it.
LLM_MODEL=gpt-4o-mini

# Leave blank for the provider default.
# OpenAI-compatible examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=

# 0 = very literal, 1 = creative. Low values suit study material.
LLM_TEMPERATURE=0.2

# Maximum length of one AI reply. Raise this if you see "answer was cut off".
LLM_MAX_OUTPUT_TOKENS=8000

# Ask the provider to return JSON directly. Set to false only if your provider
# rejects the request; the app still asks for JSON in the prompt.
LLM_JSON_MODE=true

# How long to wait for one AI reply, in seconds.
LLM_TIMEOUT=180

# Preferred caption languages, in priority order. If none exist, any available
# language is used.
TRANSCRIPT_LANGUAGES=en,en-US,en-GB

# Transcripts are split into chunks of this many characters for long videos.
TRANSCRIPT_CHUNK_CHARS=9000

# The app refuses to generate from transcripts shorter than this (in words),
# because inventing study material would be worse than stopping.
MIN_TRANSCRIPT_WORDS=150

# Safety limits: stop before an unintendedly huge API bill.
MAX_TRANSCRIPT_CHUNKS=30
LLM_MAX_WORKERS=3

# Where saved packs are kept. Leave blank for ./data.
STUDY_DATA_DIR=
