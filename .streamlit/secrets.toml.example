# Copy these values into Streamlit Community Cloud → your app → Settings → Secrets.
# Never commit a real secrets.toml (it is ignored by git).

LLM_PROVIDER = "openai"
LLM_API_KEY = "sk-your-cloud-provider-key"
LLM_MODEL = "gpt-4o-mini"
LLM_BASE_URL = "https://api.openai.com/v1"

# Required for a public app: anyone with the URL could otherwise spend your
# API credits. Pick a long passphrase and share it only with people you trust.
APP_PASSWORD = "choose-a-long-passphrase"
